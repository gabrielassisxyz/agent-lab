                                 significance_level=significance_level,
                             ):
                                 separating_sets[frozenset((u, v))] = separating_set
-                                graph.remove_edge(u, v)
+                                edges_to_remove.append((u, v))
                                 break
 
+                graph.remove_edges_from(edges_to_remove)
+
             elif variant == "parallel":
 
                 def _parallel_fun(u, v):
@@ -421,6 +428,7 @@ class _ConstraintMixin:
         temporal_ordering: dict[Hashable, int],
         graph: UndirectedGraph,
         lim_neighbors: int,
+        neighbors: dict[Hashable, set[Hashable]] | None = None,
     ) -> Collection[tuple]:
         """
         Return the temporally consistent superset of separating set of `u`, `v`.
@@ -446,13 +454,25 @@ class _ConstraintMixin:
         lim_neighbors: int
             The maximum number of neighbours (conditioning variables) for u, v.
 
+        neighbors: dict, optional
+            A precomputed snapshot of neighbors for each node. If provided,
+            neighbor sets are read from this snapshot instead of from `graph`.
+            This is used by the stable PC variant to ensure that edge removals
+            within a conditioning level do not affect the candidate separating
+            sets of other edges in the same level.
+
         Returns
         --------
         separating_set: set
             Set containing the superset of separating set of u, v.
         """
-        separating_set_u = set(graph.neighbors(u))
-        separating_set_v = set(graph.neighbors(v))
+        if neighbors is None:
+            separating_set_u = set(graph.neighbors(u))
+            separating_set_v = set(graph.neighbors(v))
+        else:
+            separating_set_u = set(neighbors.get(u, set()))
+            separating_set_v = set(neighbors.get(v, set()))
+
         separating_set_u.discard(v)
         separating_set_v.discard(u)
 
