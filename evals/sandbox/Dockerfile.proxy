# The allowlisting proxy is part of the instrument, so we own it.
#
# The stock tinyproxy image rewrites its own config at entrypoint, which means the filter
# rules are decided by someone else's shell script. For a component whose entire job is to
# be the only hole in the sandbox, that is not acceptable — the rules are baked in here.
FROM alpine:3.21

RUN apk add --no-cache tinyproxy curl

COPY proxy.conf /etc/tinyproxy/tinyproxy.conf
COPY allowlist.txt /etc/tinyproxy/allowlist.txt

EXPOSE 8888
# -d keeps it in the foreground so docker owns the lifecycle and logs land on stdout.
CMD ["tinyproxy", "-d", "-c", "/etc/tinyproxy/tinyproxy.conf"]
