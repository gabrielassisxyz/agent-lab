# The `pi` agent, baked into a portable layer.
#
# WHY a layer and not an install inside the eval image: `pi` is an npm package pulled through
# npx, so installing it at agent runtime would require network — the exact thing the sandbox
# exists to remove. Network at BUILD time is fine and is not a leak: nothing about the task is
# known here. So we resolve node + pi once, up front, and mount the result read-only into an
# eval container that has no route out at all.
#
# It also means we never rebuild the (large) per-instance eval images to add an agent.
FROM node:22-bookworm-slim

ARG PI_VERSION=latest
RUN npm install -g "@earendil-works/pi-coding-agent@${PI_VERSION}" \
 && npm cache clean --force

# The mount target inside the eval container. Everything pi needs must live under here.
RUN mkdir -p /opt/agent/bin /opt/agent/lib \
 && cp /usr/local/bin/node /opt/agent/bin/node \
 && cp -a /usr/local/lib/node_modules /opt/agent/lib/node_modules \
 && printf '#!/bin/sh\nexec /opt/agent/bin/node /opt/agent/lib/node_modules/@earendil-works/pi-coding-agent/dist/cli.js "$@"\n' \
      > /opt/agent/bin/pi \
 && chmod +x /opt/agent/bin/pi
