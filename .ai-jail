# ai-jail sandbox configuration
# https://github.com/akitaonrails/ai-jail
# Edit freely. Regenerate with: ai-jail --clean --init
#
# Docs: ~/repositories/llm-workflow/docs/tools/ai-jail.md
#
# ┌─ READ THIS BEFORE "TIDYING UP" THE DOCKER LINE ────────────────────────────┐
# │ This repo is the ONE deliberate exception to the no-docker rule.           │
# │                                                                            │
# │ Everywhere else, /var/run/docker.sock is deliberately NOT mounted, because │
# │ the socket is root ON THE HOST: an agent inside the sandbox can run        │
# │   docker run -v /:/host --privileged alpine chroot /host sh                │
# │ and walk straight out of the jail. It is a door, not a crack.              │
# │                                                                            │
# │ Here it is mounted anyway, ON PURPOSE: the benchmarks are SWE-bench        │
# │ (`~/repositories/_cloned/SWE-bench-fork`, swebench 4.0.3), which executes  │
# │ every task inside a container. No docker socket, no benchmark.             │
# │                                                                            │
# │ So: this line is NOT an oversight someone forgot to clean up. It is the    │
# │ only place where the cost was weighed and accepted. Deleting it breaks the │
# │ benchmarks; copying it to another repo silently removes that repo's        │
# │ sandbox.                                                                   │
# └────────────────────────────────────────────────────────────────────────────┘
#
#   rw ~/repositories  Cross-repo work is deliberate; git is the undo for anything under it.
#   rw ~/tmp           Scratch that outlives the jail's throwaway tmpfs /tmp.
#   hide .password-store  ro-bound by default. No business in an agent session.

command = ["claude"]
rw_maps = [
    "/home/gabriel/repositories",
    "/home/gabriel/tmp",
]
ro_maps = []
hide_dotdirs = [".password-store"]
mask = []
no_docker = false
allow_tcp_ports = []
