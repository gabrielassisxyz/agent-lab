node_modules/
target/
.venv/
__pycache__/
*.pyc

# >>> repo-harness:gitignore-private-boundary >>>
# Maintainer notes — not part of the project; they live in the private notes repo,
# reachable through the `local` symlink. NO trailing slash on any path in this block:
# a worktree materializes these paths as SYMLINKS, and a `foo/` pattern matches a real
# directory only — the ignore then keeps working in the main tree and silently fails
# in every worktree.
/local

# Environment secrets and the per-machine agent sandbox config.
.env
.ai-jail
# <<< repo-harness:gitignore-private-boundary <<<

# A local SSH keypair was created here once; keep it out of history.
windows-bibi
windows-bibi.pub

# base files lifted out of the eval image for node scoring — reproducible, not source
.cache/

# The beads tracker's own directory. Everything in it is machine-local: the SQLite
# database, its WAL and lock files, and the JSONL export beside them. Every br repo in
# this fleet ignores it the same way — what travels is the declaration in llm-workflow's
# `harness/repos`, not the database. No trailing slash, for the reason the private-boundary
# block above spells out: a worktree materializes this path as a symlink.
/.beads

# bv (beads viewer) local config and caches, written by `br init` itself.
.bv/
